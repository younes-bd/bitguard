{
  "_meta": {
    "title": "BitGuard 4-Layer Headless ERP - Layer Registry",
    "authority": "SINGLE SOURCE OF TRUTH for which layer every module belongs to. architecture.md Rule 0 and Rule 65, SYSTEM_ARCHITECTURE_MAP.md, manifests, linters and AI agents must all agree with this file. If they conflict, this file wins and the other file is wrong.",
    "odoo_baseline": "Odoo 17.0 Community manifests (application, depends, category) compared on 2026-10-05. Enterprise-only modules are marked odoo17-enterprise-unverified.",
    "how_to_change": "Edit this file first, then update the manifest and docs, then run scripts/validate_architecture.py."
  },
  "layers": {
    "1": {
      "name": "Kernel",
      "application": false,
      "launcher_tile": false,
      "tenant_removable": false,
      "ui": "none (headless)",
      "odoo_kind": "root",
      "depends_on": []
    },
    "2": {
      "name": "Platform Services",
      "application": true,
      "launcher_tile": false,
      "tenant_removable": true,
      "ui": "admin UI reachable from Settings only",
      "odoo_kind": "platform",
      "depends_on": [
        1
      ]
    },
    "3": {
      "name": "Business Applications",
      "application": true,
      "launcher_tile": true,
      "tenant_removable": true,
      "ui": "own tile, own navigation, own settings page",
      "odoo_kind": "app",
      "depends_on": [
        1,
        2,
        3
      ]
    },
    "4": {
      "name": "External Integrations",
      "application": false,
      "launcher_tile": false,
      "tenant_removable": true,
      "ui": "none or embedded; settings injected into system (Rule 55)",
      "odoo_kind": "addon-connector",
      "depends_on": [
        1,
        2,
        3
      ]
    }
  },
  "odoo_to_layer_conversion": [
    {
      "odoo": "base and UI-less foundations (bus, uom, resource, analytic, digest, utm, currency, country)",
      "layer": 1,
      "why": "Universal dependencies collapse into core (Rule 61)."
    },
    {
      "odoo": "application False, depends only on root or platform, owns an admin UI (base_setup, portal, product, payment, base_automation, web, auth_signup)",
      "layer": 2,
      "why": "Shared services consumed by apps. BitGuard sets application True so tenants can install them, but hides the tile."
    },
    {
      "odoo": "application True (account, hr, crm, stock, mrp, project, website, mail Discuss, Enterprise apps)",
      "layer": 3,
      "why": "Own tile, own navigation, own settings page."
    },
    {
      "odoo": "application False add-on that bridges an external third party (delivery carriers, payment providers, sale_amazon)",
      "layer": 4,
      "why": "External connectors with no tile (Rule 55)."
    },
    {
      "odoo": "application False internal glue between two apps (account_payment, sale_stock, purchase_stock)",
      "layer": null,
      "why": "Not a module in BitGuard. Use a Rule 12 soft dependency or registry inside the owning L3 app."
    }
  ],
  "dependency_law": {
    "rule": "A module may depend only on modules in the same or a lower layer. Layer 4 may depend on 1, 2 and 3. Layer 3 may depend on another Layer 3 module only when it is declared in its manifest depends (the Odoo DAG). Layer 3 must never hard-depend on Layer 4 (use a Rule 12 soft dependency).",
    "known_drift_to_fix": [
      "core, auth, tenants declare depends system (Layer 2). core must be the root with depends [] and system must depend on core.",
      "inventory depends procurement and projects depends crm. Odoo has neither dependency.",
      "agents (L3) declares depends ai_engine (L4). Use a soft dependency.",
      "Layer 2 modules still have application False and are hidden by that flag. They must become application True with a launcher_tile gate (see Rule 65)."
    ]
  },
  "frontend_zones": {
    "headless_l1_engine": [
      "frontend/src/core"
    ],
    "l2_proxy_ui_for_l1_modules": [
      "frontend/src/apps/core",
      "frontend/src/apps/auth",
      "frontend/src/apps/tenants"
    ],
    "note": "Rule 9C: the backend of core, auth and tenants is L1, but their frontend folders under apps/ are L2 control-plane proxy UI. Only frontend/src/core is the headless L1 engine."
  },
